<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base metallic deep emerald gradient -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="135"
                android:startColor="#06221D"
                android:centerColor="#0B3730"
                android:endColor="#031613"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Concentric radial electric ambient aura -->
    <path
        android:pathData="M54,14 A40,40 0 1 0 54,94 A40,40 0 1 0 54,14 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="40"
                android:startColor="#3B00E5FF"
                android:centerColor="#1800A884"
                android:endColor="#00000000"
                android:type="radial" />
        </aapt:attr>
    </path>

    <!-- Diagonal glass lighting sheen -->
    <path
        android:pathData="M0,0 L108,0 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="135"
                android:startColor="#1AFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </aapt:attr>
    </path>

</vector>
