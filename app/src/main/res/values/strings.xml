    <!-- Privacy: read receipts and presence -->
    <string name="hide_seen">Hide read receipts</string>
    <string name="hide_seen_summary">Do not send “seen” for direct threads. The other person keeps seeing your messages as unread.</string>
    <string name="hide_seen_thread_list">Selected accounts only</string>
    <string name="hide_seen_thread_list_summary">Leave empty to hide read receipts for everyone.</string>
    <string name="hide_typing">Hide typing indicator</string>
    <string name="hide_typing_summary">Never broadcast the typing/activity indicator to anyone.</string>
    <string name="hide_active_status">Hide Active Now</string>
    <string name="hide_active_status_summary">Do not report yourself as active. Others still see you online when you are in the app.</string>
    <string name="hide_story_views">Hide story views from selected accounts</string>
    <string name="hide_story_views_summary">Leave empty to hide your story views from everyone. A global list applies to every viewer.</string>
    <string name="screenshot_notify">Notify on screenshot / screen record</string>
    <string name="screenshot_notify_summary">Show a notification when someone captures a direct message or story.</string>

    <!-- Privacy: misc -->
    <string name="anti_emoticon_analytics">Strip emoticon/analytics payloads</string>
    <string name="anti_emoticon_analytics_summary">Blocks the event payloads Instagram attaches to outgoing requests. May break some server-side features.</string>
    <string name="hide_view_once">Disable disappearing messages</string>
    <string name="hide_view_once_summary">Keep view-once direct messages readable after the timer expires.</string>

    <!-- Media / downloader -->
    <string name="download_media">Enable media download</string>
    <string name="download_media_summary">Adds a download action to the photo and video viewer.</string>
    <string name="download_story">Enable story download</string>
    <string name="download_story_summary">Adds a download action to the story viewer.</string>
    <string name="download_reel">Enable reel download</string>
    <string name="download_reel_summary">Adds a download action to the reel viewer. Reels are fetched at source resolution.</string>
    <string name="download_named_after_user">Name files after the author</string>
    <string name="download_named_after_user_summary">Prefix downloaded files with the account name instead of a timestamp.</string>
    <string name="download_local">Download folder</string>
    <string name="download_location">Where downloads are saved</string>
    <string name="copy_caption">Copy caption</string>
    <string name="copy_caption_summary">Adds a “copy caption” action to post menus.</string>

