<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Locally known-good Instagram versions. The list is only used for the UI readout and as
        the first half of the allowlist; a remote list is merged in at runtime so a new beta
        does not require shipping a new APK. Anything at or above the baseline in
        FeatureLoader.isFutureBetaVersion is loaded optimistically regardless.
    -->
